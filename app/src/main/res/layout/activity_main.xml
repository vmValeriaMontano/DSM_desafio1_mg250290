<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/rosa_pastel"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tittle_principal"
        android:layout_marginLeft="@dimen/margin_small"
        android:layout_marginRight="@dimen/margin_small"
        android:textColor="@color/texto_titulo"
        android:textStyle="bold"
        android:gravity="center"
        android:textSize="@dimen/text_size_title"
        />

    <!--Creacion de Botones principales-->
    <Button
        android:id="@+id/Promediobtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:backgroundTint="@color/rosa_principal"
        android:textColor="@color/texto_botones"
        android:text="@string/btn_ejercicio1" />

    <Button
        android:id="@+id/Salariobtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:text="@string/btn_ejercicio2"
        android:backgroundTint="@color/rosa_encendido"
        android:textColor="@color/texto_botones"/>

    <Button
        android:id="@+id/Calculadorabtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:text="@string/btn_ejercicio3"
        android:backgroundTint="@color/magenta_suave"
        android:textColor="@color/texto_botones" />
</LinearLayout>